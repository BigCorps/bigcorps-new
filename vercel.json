{
  "buildCommand": "echo 'Static site - no build needed'",
  "outputDirectory": "public",
  "framework": "static",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ],
  "redirects": [
    {
      "source": "/solucoes",
      "destination": "/solucoes.html"
    },
    {
      "source": "/duvidas",
      "destination": "/duvidas.html"
    },
    {
      "source": "/utilitarios",
      "destination": "/utilitarios.html"
    },
    {
      "source": "/contato",
      "destination": "/contato.html"
    }
  ]
}
